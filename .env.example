# Copy to .env and adjust. Every value has a working default for a fresh clone
# (LLM_PROVIDER=fake needs no model, key or network).

# --- LLM ---------------------------------------------------------------------
# fake | ollama | anthropic | dahl | groq | auto
# auto: Dahl if it answers, else Groq, else Ollama if it is ready, else fake, checked once
# at startup. start.cmd / start.sh without an argument run that check and ask (decisions
# 0019 and 0021); fake or anthropic here skip it.
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Dahl (OpenAI-compatible open models). Models with tools (list: GET /v1/models):
# zai-org/GLM-5.3-Flash, MiniMaxAI/MiniMax-M2.7, deepseek-ai/DeepSeek-V4-Flash-0731.
# When a model is full, Dahl lets paid accounts in first; GLM-5.3-Flash was the one open
# to an account without a plan (2026-11-22).
DAHL_API_KEY=
DAHL_MODEL=zai-org/GLM-5.3-Flash
DAHL_BASE_URL=https://inference.dahl.global/v1
# Groq (OpenAI-compatible; the free tier has per-minute and per-day token limits).
# Models with tools: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# For a cloud provider (groq, dahl, anthropic): what to use without its key or after its
# daily limit, in order. ollama only when it answers with OLLAMA_MODEL; fake is demo mode.
# After a daily limit the studio stays on the fallback until it restarts.
LLM_FALLBACK=ollama,fake


# --- Mock SAP (sap-mock service) -----------------------------------------------
SAP_BASE_URL=http://localhost:8100
SAP_USER=demo
SAP_PASSWORD=demo
# sap-mock only: pin the date written on new materials (empty = today) and chaos switches
SAP_TODAY=
SAP_LATENCY_MS=0
SAP_FAIL_RATE=0
SAP_MAINTENANCE=false

# --- External tools (absolute paths on Windows, or names on PATH) -------------
# FreeCAD is optional: drawings are made in Python (decision 0009); freecadcmd only runs the
# `freecad` tests that reopen the STEP files. The winget install is per user, for example
# C:/Users/<you>/AppData/Local/Programs/FreeCAD 1.1/bin/freecadcmd.exe
FREECAD_CMD=freecadcmd
# Windows example: C:/Program Files/Blender Foundation/Blender 4.5/blender.exe
BLENDER_BIN=blender
# Catalog renders: Cycles samples (denoised) and the time limit of one Blender run
RENDER_SAMPLES=64
RENDER_TIMEOUT_S=600

# --- Frontend ------------------------------------------------------------------
# The built frontend (npm run build), served by the backend at / when it exists
FRONTEND_DIST=./frontend/dist

# --- Storage (relative paths resolve from the repo root) -----------------------
DATA_DIR=./data
DESIGNS_ROOT=./data/designs

# --- Agent ---------------------------------------------------------------------
AGENT_MAX_ITERATIONS=6

# --- Online safety (0 = off) -----------------------------------------------------
# Requests per minute per client address, counted separately for chat, card actions and
# 3D previews. Behind a proxy, run uvicorn with --proxy-headers.
RATE_LIMIT_PER_MINUTE=30
# Model tokens per UTC day for all visitors together (not counted for LLM_PROVIDER=fake)
DAILY_TOKEN_CAP=0
# Delete generated designs and their renders this many hours after their last change
DESIGNS_RETENTION_HOURS=0
